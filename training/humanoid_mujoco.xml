<mujoco model="humanoid_walker">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" iterations="50" tolerance="1e-10"/>
  <size nconmax="100" njmax="1000"/>

  <asset>
    <mesh file="../backend/humanoid.urdf"/>
  </asset>

  <default>
    <joint damping="0.1" armature="0.01"/>
    <geom friction="0.8 0.01 0.01" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <worldbody>
    <light name="light" pos="0 0 2" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="10 10 0.1" rgba="0.5 0.5 0.5 1"/>
  </worldbody>

</mujoco>